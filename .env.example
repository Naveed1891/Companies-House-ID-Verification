# DirectorKYC — environment configuration
# Copy this file to .env before running or deploying.
# Never commit .env or real secrets.

DATABASE_URL="mysql://user:pass@host:3306/directorkyc"
SHADOW_DATABASE_URL="mysql://user:pass@host:3306/directorkyc_shadow"
SESSION_SECRET=""
FOLLOW_UP_EMAILS_ENABLED="true"
# Optional: lets an external cron service trigger the same protected endpoint.
CRON_SECRET=""
NEXT_PUBLIC_SITE_URL="https://directorkyc.com"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

STORAGE_DRIVER="s3"
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="auto"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MAX_UPLOAD_SIZE_MB="10"
PRIVATE_UPLOAD_DIR="./storage/private"

EMAIL_PROVIDER="none"
EMAIL_FROM="no-reply@directorkyc.com"

SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

NEXT_PUBLIC_BRAND_NAME="DirectorKYC"
S3_FORCE_PATH_STYLE="true"

# STORAGE_DRIVER="local" is for development only.
# Production must use "s3" — the app filesystem is not durable across deploys.

# Encrypts CEO-managed credentials in the database (falls back to SESSION_SECRET).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_SECRET=""

# SMTP (optional here — the CEO can also set these in the dashboard, which overrides .env)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SUPPORT_EMAIL="support@directorkyc.com"

# CEO seed password (defaults to the provided password if unset)
SEED_CEO_PASSWORD=""
